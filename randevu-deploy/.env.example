# Copy this file to `.env` (next to this file) and adjust the values.
#   cp .env.example .env
#
# Docker Compose loads `.env` automatically and substitutes the
# ${VAR} references in docker-compose.yml. The values below are passed to the
# Postgres container (POSTGRES_*) and to the Rails app (DATABASE_*).
POSTGRES_DB=randevu_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres